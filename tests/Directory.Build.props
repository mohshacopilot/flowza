<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Same secrets store as the AppHost (passwords set once per PC); CI uses environment variables instead. -->
  <PropertyGroup>
    <UserSecretsId>flowza-dev</UserSecretsId>
  </PropertyGroup>

  <!-- Shared settings for the test projects (names ending in "Tests"; tech discussion T8).
       Helper libraries such as Flowza.Testing are plain class libraries. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.MTP" />
  </ItemGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>
</Project>
