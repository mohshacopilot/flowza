@using Flowza.Identity.Application.Abstractions
@inject IInstallationBrandSource Brands
@{
    // The installation's own name and initials mark (UI-08, C6, C7); read here, so the login pages work even when
    // the web app or the Gateway's API routes are down (spec 007 edge case).
    var brand = await Brands.GetAsync(Context.RequestAborted);
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@T[AccountTexts.DocumentTitle, ViewData["Title"] ?? string.Empty, brand.Name]</title>
    @* Generated from the web app's design values (npm run design:css, UI-02); account.css holds the layout only.
       asp-append-version adds a hash of the file (?v=…), so browsers fetch a changed file at once after an upgrade. *@
    <link rel="stylesheet" href="/account/assets/design-values.css" asp-append-version="true" />
    <link rel="stylesheet" href="/account/assets/account.css" asp-append-version="true" />
    <script src="/account/assets/account.js" asp-append-version="true" defer></script>
</head>
<body data-show-password-label="@T[AccountTexts.ShowPassword]">
    <a class="skip-link" href="#main">@T[AccountTexts.SkipToContent]</a>
    <div class="account">
        @* Mockup B (spec 007 amendment 1): the deep teal panel, the same colours as the app's side navigation. *@
        <header class="brand-panel">
            <div class="brand">
                <span class="brand-mark" aria-hidden="true">@brand.Initials</span>
                <span class="brand-name" title="@brand.Name">@brand.Name</span>
            </div>
            <div class="brand-story">
                @* A request going through its steps; decorative only (UI-01-AC1), so screen readers skip it. *@
                <div class="workflow" aria-hidden="true">
                    <span class="workflow-step">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5M9 13h6M9 17h6" /></svg>
                        @T[AccountTexts.WorkflowForm]
                    </span>
                    <span class="workflow-line"></span>
                    <span class="workflow-step">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="4" /><path d="M3 21v-1a6 6 0 0 1 9-5.2M16 19l2 2 4-4" /></svg>
                        @T[AccountTexts.WorkflowApprove]
                    </span>
                    <span class="workflow-line"></span>
                    <span class="workflow-step workflow-step-done">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M8 12l3 3 5-6" /></svg>
                        @T[AccountTexts.WorkflowDone]
                    </span>
                </div>
                <p class="product-line">@T[AccountTexts.ProductLine]</p>
                <ul class="highlights">
                    @foreach (var highlight in AccountTexts.Highlights)
                    {
                        <li><svg class="tick" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7" /></svg>@T[highlight]</li>
                    }
                </ul>
            </div>
        </header>
        <div class="form-column">
            <main id="main" class="form-card">
                @RenderBody()
            </main>
            <footer class="powered-by">@T[AccountTexts.PoweredBy]</footer>
        </div>
    </div>
</body>
</html>
