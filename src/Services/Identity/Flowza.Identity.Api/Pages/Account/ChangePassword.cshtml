@page "/account/change-password"
@model Flowza.Identity.Api.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = T[AccountTexts.ChangePasswordTitle];
}

<h1>@T[AccountTexts.ChangePasswordTitle]</h1>
<p>@T[AccountTexts.ChangePasswordIntro]</p>

@if (Model.Errors.Count > 0)
{
    <div class="errors" role="alert" id="change-errors">
        @T[AccountTexts.ErrorSummaryTitle]
        <ul>
            @foreach (var error in Model.Errors)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

<form method="post" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />
    <div class="field">
        <label for="current-password">@T[AccountTexts.ChangePasswordCurrent]</label>
        <input id="current-password" name="CurrentPassword" type="password" autocomplete="current-password" required autofocus />
    </div>
    <div class="field">
        <label for="new-password">@T[AccountTexts.ChangePasswordNew]</label>
        <input id="new-password" name="NewPassword" type="password" autocomplete="new-password" required aria-describedby="password-rules" />
        <p class="hint" id="password-rules">@T[AccountTexts.ChangePasswordRules]</p>
    </div>
    <div class="field">
        <label for="confirm-password">@T[AccountTexts.ChangePasswordConfirm]</label>
        <input id="confirm-password" name="ConfirmPassword" type="password" autocomplete="new-password" required />
    </div>
    <button type="submit">@T[AccountTexts.ChangePasswordSubmit]</button>
</form>
