{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "Protection": {
      "MaxRequestBodyBytes": 1048576,
      "LoginPerAddress": { "PermitLimit": 10, "Window": "00:01:00" },
      "ApiPerUser": { "PermitLimit": 600, "Window": "00:01:00" }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-api": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/identity/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/{**catch-all}" } ],
        "Metadata": { "Flowza.ForwardAccessToken": "true" }
      },
      "design-api": {
        "ClusterId": "design",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/design/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/{**catch-all}" } ],
        "Metadata": { "Flowza.ForwardAccessToken": "true" }
      },
      "runtime-api": {
        "ClusterId": "runtime",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/runtime/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/{**catch-all}" } ],
        "Metadata": { "Flowza.ForwardAccessToken": "true" }
      },
      "worker-api": {
        "ClusterId": "worker",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/worker/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/{**catch-all}" } ],
        "Metadata": { "Flowza.ForwardAccessToken": "true" }
      },
      "identity-connect": {
        "ClusterId": "identity",
        "Match": { "Path": "/connect/{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "identity-account": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "login",
        "Match": { "Path": "/account/{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      }
    },
    "Clusters": {
      "identity": { "Destinations": { "identity": { "Address": "http://identity" } } },
      "design": { "Destinations": { "design": { "Address": "http://design" } } },
      "runtime": { "Destinations": { "runtime": { "Address": "http://runtime" } } },
      "worker": { "Destinations": { "worker": { "Address": "http://worker" } } }
    }
  }
}
