<Project>
  <!-- Central Package Management: every package version lives here (tech discussion T1, TS4).
       Only libraries approved by the owner may be added (constitution 1.6 and 9.4). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets the "Security fixes" pins below override vulnerable versions pulled in by other packages. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Security fixes (transitive pins)">
    <!-- Microsoft.Data.SqlClient 6.1.7 brings 9.0.11, which has known vulnerabilities (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- OpenIddict 7.7.2 brings 10.0.11 (GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj, GHSA-r955-8q5j-3h83). -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Data">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <!-- Same version EF Core uses; the AppHost builds connection strings with its SqlConnectionStringBuilder. -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.7" />
  </ItemGroup>
  <ItemGroup Label="Observability">
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
  </ItemGroup>
  <ItemGroup Label="Hosting">
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="AspNetCore.HealthChecks.SqlServer" Version="9.0.0" />
    <!-- Same version as the Aspire AppHost SDK; runs the web app's Vite dev server as a program (no container). -->
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.6.3" />
  </ItemGroup>
  <ItemGroup Label="Gateway">
    <!-- YARP (MIT): approved in plan 001 PA6. -->
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <!-- Aspire service discovery for YARP's destinations (GW6); same family and version as Microsoft.Extensions.ServiceDiscovery. -->
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="10.11.0" />
    <!-- First-party ASP.NET Core OpenID Connect handler for the BFF login (plan 001 §9, SE1). -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Messaging">
    <PackageVersion Include="WolverineFx" Version="6.51.2" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="6.51.2" />
    <PackageVersion Include="WolverineFx.SqlServer" Version="6.51.2" />
    <PackageVersion Include="WolverineFx.AzureServiceBus" Version="6.51.2" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.51.2" />
  </ItemGroup>
  <ItemGroup Label="Identity">
    <!-- OpenIddict (Apache 2.0): approved in plan 001 PA6. -->
    <PackageVersion Include="OpenIddict.AspNetCore" Version="7.7.2" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.7.2" />
    <PackageVersion Include="OpenIddict.Validation.AspNetCore" Version="7.7.2" />
    <PackageVersion Include="OpenIddict.Validation.SystemNetHttp" Version="7.7.2" />
    <!-- First-party ASP.NET Core package for the "OpenAPI document per service" convention (CLAUDE.md, APIs). -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Configuration">
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <!-- Tests run on Microsoft.Testing.Platform (global.json "test.runner"); coverlet.MTP is coverlet's extension for it. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
  </ItemGroup>
</Project>
